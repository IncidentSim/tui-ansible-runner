[Unit]
Description=IncidentSim echo-server container
After=docker.service
Requires=docker.service

[Service]
Type=simple
Restart=always
RestartSec=2
ExecStartPre=-/usr/bin/docker rm -f {{ app_container }}
ExecStart=/usr/bin/docker run --rm --name {{ app_container }} --publish 127.0.0.1:8080:8080 {{ app_image }}
ExecStop=/usr/bin/docker stop --time 10 {{ app_container }}

[Install]
WantedBy=multi-user.target
